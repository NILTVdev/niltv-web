# Build outputs - regenerated from the live API by scripts/build-pages.mjs (run by deploy.ps1).
# /channels/*/ matches only subdirectories, so /channels/index.html (the hand-authored hub) stays tracked.
/watch/
/channels/*/
/sitemap.xml
/robots.txt
/llms.txt
/build.json

# OS junk
Thumbs.db
desktop.ini
.DS_Store

# deps / local artifacts
node_modules/
*.zip
*.log
deploy-log.txt
scripts/__pycache__/
rebuild-log.txt

# python bytecode anywhere (builders import each other now)
__pycache__/

# env & secrets — never commit real values
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*secret*.json
*credentials*.json
# private data (never commit) - lives in the private data folder, see DEVELOPING.md.
# athletes/<slug>/ + index.json are regenerated by scripts/builders/build-athletes.py;
# fixtures come from scripts/dev/capture-fixtures.py; the JSON rosters are hand-copied.
/athletes/*/
/athletes/_data/
/athletes/index.json
/fixtures/api/
/concepts-data.json
/scripts/builders/network-brands.json
/scripts/builders/_amb_files.json
# the partners page carries private campaign figures: build-sections.py + promote.py
# regenerate it from the private data folder before a dev deploy
/partners/index.html
# maintainer scripts copied in for a single run; never committed
/scripts/_local_*

# scratch and drafts (private folder holds the archive; see DEVELOPING.md)
/concepts/
/_legacy/
